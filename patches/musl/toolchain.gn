import("//build/toolchain/gcc_toolchain.gni")

declare_args() {
  # Absolute path to the musl cross-toolchain "bin" directory (the one
  # containing `<prefix>-gcc` etc.). Required because recent chromium
  # build/ versions list `ar` as an input to alink() and resolve bare
  # names relative to root_out_dir instead of $PATH.
  musl_toolchain_bin = ""
}
assert(musl_toolchain_bin != "",
       "musl_toolchain_bin must be set in args.gn for musl builds")

gcc_toolchain("x86") {
  toolprefix = "${musl_toolchain_bin}/i686-linux-musl-"

  cc = "${toolprefix}gcc"
  cxx = "${toolprefix}g++"

  readelf = "${toolprefix}readelf"
  nm = "${toolprefix}nm"
  ar = "${toolprefix}ar"
  ld = cxx

  extra_ldflags = "-static-libgcc -static-libstdc++"

  toolchain_args = {
    current_cpu = "x86"
    current_os = "linux"

    use_remoteexec = false
    is_clang = false
  }
}

gcc_toolchain("x64") {
  toolprefix = "${musl_toolchain_bin}/x86_64-linux-musl-"

  cc = "${toolprefix}gcc"
  cxx = "${toolprefix}g++"

  readelf = "${toolprefix}readelf"
  nm = "${toolprefix}nm"
  ar = "${toolprefix}ar"
  ld = cxx

  extra_ldflags = "-static-libgcc -static-libstdc++"

  toolchain_args = {
    current_cpu = "x64"
    current_os = "linux"

    use_remoteexec = false
    is_clang = false
  }
}

gcc_toolchain("arm") {
  toolprefix = "${musl_toolchain_bin}/arm-linux-musleabihf-"

  cc = "${toolprefix}gcc"
  cxx = "${toolprefix}g++"

  readelf = "${toolprefix}readelf"
  nm = "${toolprefix}nm"
  ar = "${toolprefix}ar"
  ld = cxx

  extra_ldflags = "-static-libgcc -static-libstdc++"

  toolchain_args = {
    current_cpu = "arm"
    current_os = "linux"

    use_remoteexec = false
    is_clang = false
  }
}

gcc_toolchain("arm64") {
  toolprefix = "${musl_toolchain_bin}/aarch64-linux-musl-"

  cc = "${toolprefix}gcc"
  cxx = "${toolprefix}g++"

  readelf = "${toolprefix}readelf"
  nm = "${toolprefix}nm"
  ar = "${toolprefix}ar"
  ld = cxx

  extra_cxxflags= "-flax-vector-conversions"  # issue #150
  extra_ldflags = "-static-libgcc -static-libstdc++"

  toolchain_args = {
    current_cpu = "arm64"
    current_os = "linux"

    use_remoteexec = false
    is_clang = false
  }
}
