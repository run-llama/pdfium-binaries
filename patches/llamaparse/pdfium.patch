+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFFont_GetCharGlyphName(FPDF_FONT font,
+                          uint32_t char_code,
+                          char* buffer,
+                          unsigned long length) {
+  auto* pFont = CPDFFontFromFPDFFont(font);
+  if (!pFont) {
+    return 0;
+  }
+
+  ByteString glyph_name;
+
+  // Prefer the PDF-assigned name from /Encoding /Differences (simple fonts)
+  // over FreeType's built-in name — PDFs commonly remap charcodes here.
+  RetainPtr<const CPDF_Dictionary> font_dict = pFont->GetFontDict();
+  if (font_dict) {
+    RetainPtr<const CPDF_Dictionary> enc_dict =
+        font_dict->GetDictFor("Encoding");
+    if (enc_dict) {
+      RetainPtr<const CPDF_Array> diffs =
+          enc_dict->GetArrayFor("Differences");
+      if (diffs) {
+        uint32_t cur = 0;
+        for (size_t i = 0; i < diffs->size(); ++i) {
+          RetainPtr<const CPDF_Object> obj = diffs->GetDirectObjectAt(i);
+          if (!obj) {
+            continue;
+          }
+          if (obj->IsNumber()) {
+            cur = obj->GetInteger();
+          } else if (obj->IsName()) {
+            if (cur == char_code) {
+              glyph_name = obj->GetString();
+              break;
+            }
+            cur++;
+          }
+        }
+      }
+    }
+  }
+
+  if (glyph_name.IsEmpty()) {
+    int glyph_index = pFont->GlyphFromCharCode(char_code, nullptr);
+    if (glyph_index > 0) {
+      CFX_Font* cfx_font = pFont->GetFont();
+      if (cfx_font) {
+        RetainPtr<CFX_Face> face = cfx_font->GetFace();
+        if (face) {
+          glyph_name = face->GetGlyphName(glyph_index);
+        }
+      }
+    }
+  }
+
+  if (glyph_name.IsEmpty()) {
+    return 0;
+  }
+
+  const unsigned long needed =
+      static_cast<unsigned long>(glyph_name.GetLength()) + 1;
+  if (buffer && length >= needed) {
+    memcpy(buffer, glyph_name.c_str(), needed);
+  }
+  return needed;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFFont_GetEncoding(FPDF_FONT font, char* buffer, unsigned long length) {
+  auto* pFont = CPDFFontFromFPDFFont(font);
+  if (!pFont) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Dictionary> font_dict = pFont->GetFontDict();
+  if (!font_dict) {
+    return 0;
+  }
+
+  ByteString enc_name;
+  RetainPtr<const CPDF_Object> enc_obj =
+      font_dict->GetDirectObjectFor("Encoding");
+  if (enc_obj) {
+    if (enc_obj->IsName()) {
+      enc_name = enc_obj->GetString();
+    } else if (enc_obj->IsDictionary()) {
+      const CPDF_Dictionary* enc_d = enc_obj->AsDictionary();
+      RetainPtr<const CPDF_Object> base =
+          enc_d->GetDirectObjectFor("BaseEncoding");
+      if (base && base->IsName()) {
+        enc_name = base->GetString();
+      } else {
+        enc_name = "Custom";
+      }
+    }
+  }
+
+  if (enc_name.IsEmpty()) {
+    return 0;
+  }
+
+  const unsigned long needed =
+      static_cast<unsigned long>(enc_name.GetLength()) + 1;
+  if (buffer && length >= needed) {
+    memcpy(buffer, enc_name.c_str(), needed);
+  }
+  return needed;
+}
