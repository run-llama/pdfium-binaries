+// LlamaParse API.
+// Function: FPDFText_GetCharCode
+//          Get original charater code of a character in a page.
+// Parameters:
+//          text_page   -   Handle to a text page information structure.
+//                          Returned by FPDFText_LoadPage function.
+//          index       -   Zero-based index of the character.
+// Return value:
+//          The char code of the particular character.
+//
+FPDF_EXPORT unsigned int FPDF_CALLCONV
+FPDFText_GetCharCode(FPDF_TEXTPAGE text_page, int index);
+
+// LlamaParse API.
+// Packed per-character record filled by FPDFText_GetCharInfoBatch. Field
+// values match the corresponding single-character getters:
+//   text_object      - FPDFText_GetTextObject (may be NULL)
+//   left/right/
+//   bottom/top       - FPDFText_GetCharBox (page space)
+//   loose_box        - FPDFText_GetLooseCharBox
+//   font_size        - FPDFText_GetFontSize
+//   unicode          - FPDFText_GetUnicode
+//   char_code        - FPDFText_GetCharCode
+//   char_type        - raw CPDF_TextPage::CharType value: 0 = normal,
+//                      1 = generated, 2 = no-unicode-mapping (see
+//                      FPDFText_HasUnicodeMapError), 3 = hyphen,
+//                      4 = piece, 5 = actual-text
+//   text_render_mode - FPDFTextObj_GetTextRenderMode of the char's text
+//                      object, or -1 when there is none
+typedef struct FPDF_CHARINFO_LP_ {
+  FPDF_PAGEOBJECT text_object;
+  double left;
+  double right;
+  double bottom;
+  double top;
+  FS_RECTF loose_box;
+  float font_size;
+  unsigned int unicode;
+  unsigned int char_code;
+  int char_type;
+  int text_render_mode;
+} FPDF_CHARINFO_LP;
+
+// LlamaParse API.
+// Function: FPDFText_GetCharInfoBatch
+//          Fill |buffer| with per-character info for |count| characters
+//          starting at |start_index|, replacing one FFI round-trip per field
+//          per character with a single call.
+// Parameters:
+//          text_page   -   Handle to a text page information structure.
+//                          Returned by FPDFText_LoadPage function.
+//          start_index -   Zero-based index of the first character.
+//          count       -   Number of characters to read.
+//          buffer      -   Caller-allocated array of at least |count| records.
+// Return value:
+//          Number of records written (may be less than |count| when the range
+//          runs past the last character), or -1 on invalid arguments.
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFText_GetCharInfoBatch(FPDF_TEXTPAGE text_page,
+                          int start_index,
+                          int count,
+                          FPDF_CHARINFO_LP* buffer);
+
