+FPDF_EXPORT FPDF_FONT_TYPE FPDF_CALLCONV FPDFFont_GetType(FPDF_FONT font) {
+  auto* pFont = CPDFFontFromFPDFFont(font);
+  if (!pFont) {
+    return FPDF_FONTTYPE_UNKNOWN;
+  }
+
+  // NOTE: Type0 (composite) is not exposed by underlying cpdf SDK,
+  // returned type for Type0 fonts will be the descendant CID font type.
+  if (pFont->IsType1Font()) {
+      return FPDF_FONTTYPE_TYPE1;
+  }
+  if (pFont->IsTrueTypeFont()) {
+      return FPDF_FONTTYPE_TRUETYPE;
+  }
+  if (pFont->IsType3Font()) {
+      return FPDF_FONTTYPE_TYPE3;
+  }
+  if (pFont->IsCIDFont()) {
+      CPDF_CIDFont* pCIDFont = pFont->AsCIDFont();
+      if (pCIDFont->IsCIDType0()) {
+          return FPDF_FONTTYPE_CID_TYPE0;
+      }
+      return FPDF_FONTTYPE_CID_TYPE2;
+  }
+
+  return FPDF_FONTTYPE_UNKNOWN;
+}
