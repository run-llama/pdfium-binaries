+FPDF_EXPORT int FPDF_CALLCONV
+FPDFText_GetCharInfoBatch(FPDF_TEXTPAGE text_page,
+                          int start_index,
+                          int count,
+                          FPDF_CHARINFO_LP* buffer) {
+  if (!buffer || count <= 0) {
+    return -1;
+  }
+  CPDF_TextPage* textpage = GetTextPageForValidIndex(text_page, start_index);
+  if (!textpage) {
+    return -1;
+  }
+  const int64_t total = textpage->CountChars();
+  const int64_t end =
+      std::min(static_cast<int64_t>(start_index) + count, total);
+  int written = 0;
+  for (int64_t i = start_index; i < end; ++i) {
+    const CPDF_TextPage::CharInfo& charinfo = textpage->GetCharInfo(i);
+    FPDF_CHARINFO_LP* out = &buffer[written++];
+    out->text_object = FPDFPageObjectFromCPDFPageObject(
+        const_cast<CPDF_TextObject*>(charinfo.text_object()));
+    out->left = charinfo.char_box().left;
+    out->right = charinfo.char_box().right;
+    out->bottom = charinfo.char_box().bottom;
+    out->top = charinfo.char_box().top;
+    out->loose_box = FSRectFFromCFXFloatRect(charinfo.loose_char_box());
+    out->font_size = textpage->GetCharFontSize(i);
+    out->unicode = charinfo.unicode();
+    unsigned int batch_char_code = charinfo.char_code();
+    out->char_code =
+        batch_char_code == CPDF_Font::kInvalidCharCode ? 0 : batch_char_code;
+    out->char_type = static_cast<int>(charinfo.char_type());
+    const CPDF_TextObject* text_object = charinfo.text_object();
+    out->text_render_mode =
+        text_object ? static_cast<int>(text_object->GetTextRenderMode()) : -1;
+  }
+  return written;
 }
 
