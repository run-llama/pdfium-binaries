+FPDF_EXPORT unsigned int FPDF_CALLCONV
+FPDFText_GetCharCode(FPDF_TEXTPAGE text_page, int index) {
+  CPDF_TextPage* textpage = GetTextPageForValidIndex(text_page, index);
+  if (!textpage) {
+    return 0;
+  }
+
+  const CPDF_TextPage::CharInfo& charinfo = textpage->GetCharInfo(index);
+  unsigned int char_code = charinfo.char_code();
+  if (char_code == CPDF_Font::kInvalidCharCode) {
+    return 0;
+  }
+  return char_code;
+}
