diff --git a/core/fxcrt/fx_memory_mimalloc.cpp b/core/fxcrt/fx_memory_mimalloc.cpp
new file mode 100644
index 0000000..2bc4188
--- /dev/null
+++ b/core/fxcrt/fx_memory_mimalloc.cpp
@@ -0,0 +1,83 @@
+// Copyright 2022 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// llamaparse: fx_memory_malloc.cpp with the allocation funnels pointed at the
+// vendored mimalloc (//third_party/mimalloc). Content-stream parsing is
+// dominated by tiny ByteString / CPDF_Object allocations, and the system
+// allocator was ~25% of a text-extraction profile.
+//
+// This is not a malloc override. libc malloc is untouched, so bundled C
+// libraries that call it directly keep using it, and the host process keeps
+// its own allocator. Pairing is preserved by construction: FX_Alloc/FX_Free
+// and new/delete each stay on one side, exactly as with PartitionAlloc.
+
+#include "core/fxcrt/fx_memory.h"
+
+#include <mimalloc.h>
+
+#include <limits>
+
+#include "build/build_config.h"
+#include "core/fxcrt/fx_safe_types.h"
+
+#if defined(PDF_USE_PARTITION_ALLOC) || !defined(PDF_USE_MIMALLOC)
+#error "File compiled under wrong build option."
+#endif
+
+// Defines this module's global C++ operator new/delete in terms of
+// mi_new/mi_free. Include exactly once per module.
+#include <mimalloc-new-delete.h>
+
+namespace pdfium {
+namespace internal {
+
+// Slightly less than 2GB, typically.
+constexpr size_t kMallocSizeLimit = std::numeric_limits<int>::max() - (1 << 12);
+
+void* Alloc(size_t num_members, size_t member_size) {
+  FX_SAFE_SIZE_T total = member_size;
+  total *= num_members;
+  if (!total.IsValid() || total.ValueOrDie() >= kMallocSizeLimit) {
+    return nullptr;
+  }
+  return mi_malloc(total.ValueOrDie());
+}
+
+void* Calloc(size_t num_members, size_t member_size) {
+  FX_SAFE_SIZE_T total = member_size;
+  total *= num_members;
+  if (!total.IsValid() || total.ValueOrDie() >= kMallocSizeLimit) {
+    return nullptr;
+  }
+  return mi_calloc(num_members, member_size);
+}
+
+void* Realloc(void* ptr, size_t num_members, size_t member_size) {
+  FX_SAFE_SIZE_T total = num_members;
+  total *= member_size;
+  if (!total.IsValid() || total.ValueOrDie() >= kMallocSizeLimit) {
+    return nullptr;
+  }
+  return mi_realloc(ptr, total.ValueOrDie());
+}
+
+void Dealloc(void* ptr) {
+  mi_free(ptr);
+}
+
+void* StringAlloc(size_t num_members, size_t member_size) {
+  FX_SAFE_SIZE_T total = member_size;
+  total *= num_members;
+  if (!total.IsValid()) {
+    return nullptr;
+  }
+  return mi_malloc(total.ValueOrDie());
+}
+
+void StringDealloc(void* ptr) {
+  mi_free(ptr);
+}
+
+}  // namespace internal
+}  // namespace pdfium
