+// this font are derived from the font's encoding alone and may be garbage for
+// fonts using a custom or Identity encoding.
+//
+// font - the handle to the font object.
+//
+// Returns 1 if /ToUnicode is present, 0 otherwise (including on invalid font).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDFFont_HasToUnicode(FPDF_FONT font);
+
+// LlamaParse API.
+// Get the PostScript glyph name that |font| assigns to |char_code|.
+// Searches /Encoding /Differences first (the PDF-assigned override for simple
+// fonts), then falls back to the embedded font program's glyph name table via
+// FreeType. The name (e.g. "A", "uni0041", "g42") can be resolved against the
+// Adobe Glyph List to recover unicode when /ToUnicode is missing.
+//
+// font      - the handle to the font object.
+// char_code - the char code as it appears in the PDF content stream.
+// buffer    - buffer to receive the NUL-terminated name; may be NULL to query.
+// length    - size of |buffer| in bytes.
+//
+// Returns the number of bytes required (including the terminator), or 0 on
+// failure. If the buffer is too small, no bytes are written.
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFFont_GetCharGlyphName(FPDF_FONT font,
+                          uint32_t char_code,
+                          char* buffer,
+                          unsigned long length);
+
+// LlamaParse API.
+// Get the encoding name of |font|. Returns the /Encoding name directly (e.g.
+// "Identity-H", "WinAnsiEncoding") when the font dictionary's /Encoding entry
+// is a name, the /BaseEncoding name when /Encoding is a dictionary that
+// defines one, or the literal string "Custom" when /Encoding is a dictionary
+// without a /BaseEncoding (typical of font-private encodings).
+//
+// font   - the handle to the font object.
+// buffer - buffer to receive the NUL-terminated name; may be NULL to query.
+// length - size of |buffer| in bytes.
+//
+// Returns the number of bytes required (including the terminator), or 0 on
+// failure. If the buffer is too small, no bytes are written.
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFFont_GetEncoding(FPDF_FONT font, char* buffer, unsigned long length);
+
+// LlamaParse API.
+// Get the glyph index in |font|'s embedded font program for |char_code|.
+// Pair with FPDFFont_GetGlyphPath to render individual glyphs (e.g. for a
+// per-glyph OCR fallback when glyph names are unavailable).
+//
+// font      - the handle to the font object.
+// char_code - the char code as it appears in the PDF content stream.
+//
+// Returns the glyph index (>= 0), or -1 on invalid font.
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFFont_GetCharGlyphIndex(FPDF_FONT font, uint32_t char_code);
