// WASI stub: <thread>
// WASI (wasip1) is single-threaded.  Provide minimal types so that code
// which includes <thread> (e.g. abseil sysinfo.cc) compiles without the
// real threading support that libc++ omits for WASI.
#ifndef _WASI_STUB_THREAD_
#define _WASI_STUB_THREAD_
// Also define libc++'s include guard so the real (broken) <thread> is skipped.
#define _LIBCPP_THREAD

#include <cstddef>

namespace std {

class thread {
public:
    class id {
    public:
        id() noexcept = default;
        friend bool operator==(id, id) noexcept { return true; }
        friend bool operator!=(id, id) noexcept { return false; }
        friend bool operator<(id, id) noexcept { return false; }
        friend bool operator<=(id, id) noexcept { return true; }
        friend bool operator>(id, id) noexcept { return false; }
        friend bool operator>=(id, id) noexcept { return true; }
    };

    thread() noexcept = default;
    thread(const thread&) = delete;
    thread& operator=(const thread&) = delete;
    thread(thread&&) noexcept = default;
    thread& operator=(thread&&) noexcept = default;

    bool joinable() const noexcept { return false; }
    id get_id() const noexcept { return id(); }
    void join() {}
    void detach() {}

    static unsigned hardware_concurrency() noexcept { return 1; }
};

namespace this_thread {
    inline thread::id get_id() noexcept { return thread::id(); }
}  // namespace this_thread

template <>
struct hash<thread::id> {
    size_t operator()(thread::id) const noexcept { return 0; }
};

}  // namespace std

#endif  // _WASI_STUB_THREAD_
